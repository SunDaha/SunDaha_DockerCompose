# ==================== MinIO 配置 ====================

# ---- 认证 ----
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=SunDaha_8322368

# ---- 区域 ----
MINIO_REGION_NAME=cn-east-1

# ---- 存储桶版本控制（可选） ----
# MINIO_BUCKET_VERSIONING=on

# ---- API 设置 ----
# 请求截止时间
MINIO_API_REQUESTS_DEADLINE=10s
# 最大并发请求数 (0=无限制)
MINIO_API_REQUESTS_MAX=0
# 分片上传过期清理时间
MINIO_API_STALE_UPLOADS_EXPIRY=24h

# ---- 控制台 ----
MINIO_BROWSER=on
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# ---- 压缩（对文本类文件启用压缩） ----
MINIO_COMPRESS_ENABLED=on
MINIO_COMPRESS_EXTENSIONS=.txt,.log,.csv,.json,.xml,.html,.css,.js,.md
MINIO_COMPRESS_MIME_TYPES=text/*,application/json,application/xml

# ---- 日志 ----
MINIO_LOGGER_HTTP_ENABLED=off

# ---- 遥测（关闭数据上报） ----
MINIO_UPDATE=off
MINIO_CALLHOME_ENABLE=off
